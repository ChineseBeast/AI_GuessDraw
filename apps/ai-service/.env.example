# MiniMax-M3 official API configuration.
# Copy this file to .env and replace the placeholder key.

# OpenAI-compatible endpoint retained for compatible service calls.
MINIMAX_API_KEY=sk-api-your-key-here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# The fixed "minimax" provider uses the Anthropic-compatible endpoint.
MINIMAX_ANTHROPIC_API_KEY=sk-api-your-key-here
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_ANTHROPIC_MODEL=MiniMax-M3
